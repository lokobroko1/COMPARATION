# ─── 4. UTILIDADES DE EASING ─────────────────────────────────────
def ease_out_cubic(t):
    t = max(0.0, min(1.0, t))
    return 1 - (1 - t) ** 3

def ease_in_cubic(t):
    t = max(0.0, min(1.0, t))
    return t * t * t

def ease_in_out(t):
    t = max(0.0, min(1.0, t))
    return 4*t*t*t if t < 0.5 else 1 - (-2*t+2)**3/2

def ease_out_back(t, s=1.70158):
    t = max(0.0, min(1.0, t))
    return 1 + (s+1)*(t-1)**3 + s*(t-1)**2

# ─── 5. ESFERA 3D CON ILUMINACIÓN PHONG (numpy) ──────────────────
_sphere_cache: dict = {}

def create_sphere(size_px: int, base_color: tuple, glow_color: tuple) -> Image.Image:
    """Renderiza una esfera RGBA con shading Phong vectorizado."""
    key = (size_px, base_color, glow_color)
    if key in _sphere_cache:
        return _sphere_cache[key]

    pad = max(30, size_px // 8)
    s   = size_px + pad * 2
    cx  = cy = s // 2
    r   = size_px / 2.0

    yg, xg = np.mgrid[0:s, 0:s]
    dx = (xg - cx) / r
    dy = (yg - cy) / r
    d2 = dx*dx + dy*dy
    inside = d2 <= 1.0

    nz = np.sqrt(np.maximum(0.0, 1.0 - d2))

    # Luz dirección: arriba-izquierda-frente
    lx, ly, lz = -0.45, -0.65, 0.62
    ln = math.sqrt(lx*lx + ly*ly + lz*lz)
    lx, ly, lz = lx/ln, ly/ln, lz/ln

    ndotl = -(dx*lx + dy*ly + nz*lz)
    diffuse = np.maximum(0.0, ndotl)

    # Especular Phong (reflección de vista)
    rx = 2*ndotl*dx - lx    # r = 2(n·l)n - l
    ry = 2*ndotl*dy - ly
    rz = 2*ndotl*nz - lz
    spec = np.power(np.maximum(0.0, rz), 55)  # vista = (0,0,1)

    # Rim lighting (luz del borde)
    rim = np.where(inside, np.power(np.maximum(0.0, 1.0 - np.abs(nz)), 5) * 0.35, 0.0)

    brightness = np.where(inside, 0.05 + 0.78*diffuse + 0.55*spec, 0.0)
    brightness = np.clip(brightness, 0.0, 1.0)

    bc = np.array(base_color[:3], dtype=np.float32) / 255.0
    gc = np.array(glow_color[:3],  dtype=np.float32) / 255.0

    img = np.zeros((s, s, 4), dtype=np.uint8)
    for i in range(3):
        ch  = brightness * bc[i]           # base iluminada
        ch  = ch + spec  * 0.85            # especular blanca
        ch  = ch + rim   * gc[i] * 1.2    # rim con color de glow
        img[:,:,i] = (np.clip(ch, 0, 1) * 255).astype(np.uint8)
    img[:,:,3] = np.where(inside, 255, 0).astype(np.uint8)

    sphere = Image.fromarray(img, 'RGBA')

    # Glow exterior difuso
    glow = Image.new('RGBA', (s, s), (0,0,0,0))
    gd   = ImageDraw.Draw(glow)
    gc8  = tuple(int(c*255) for c in gc)
    gr   = max(6, size_px // 15)
    glow_r = int(r * 1.15)
    gd.ellipse([cx-glow_r, cy-glow_r, cx+glow_r, cy+glow_r],
               fill=(*gc8[:3], 70))
    glow = glow.filter(ImageFilter.GaussianBlur(radius=gr))

    out = Image.new('RGBA', (s, s), (0,0,0,0))
    out.paste(glow,   (0,0), glow)
    out.paste(sphere, (0,0), sphere)

    _sphere_cache[key] = out
    return out

# ─── 6. FONDO ESTELAR (pre-calculado una vez) ────────────────────
def build_starfield(w: int, h: int, seed: int = 42) -> Image.Image:
    rng = np.random.default_rng(seed)
    img  = Image.new('RGB', (w, h), BG_COLOR)
    draw = ImageDraw.Draw(img)

    # Nebulosas de fondo (elipses de color tenue)
    nebula_params = [
        (360, 220, 480, 320, (28, 12, 55)),
        (1550,800, 400, 260, (12, 22, 48)),
        (950, 540, 600, 380, (35, 12, 42)),
        (200, 700, 350, 280, (14, 28, 52)),
        (1700,200, 300, 200, (40, 16, 36)),
    ]
    for cx, cy, rx, ry, col in nebula_params:
        for j in range(12, 0, -1):
            t  = j / 12
            rc = tuple(int(c * t * 0.45) for c in col)
            draw.ellipse([cx - int(rx*t), cy - int(ry*t),
                          cx + int(rx*t), cy + int(ry*t)], fill=rc)

    # Estrellas pequeñas (fondo lejano)
    xs = rng.integers(0, w, 1400); ys = rng.integers(0, h, 1400)
    bs = rng.integers(50, 170, 1400)
    for x, y, b in zip(xs, ys, bs):
        draw.point((x, y), fill=(b, b, min(255, b+15)))

    # Estrellas medianas
    xs = rng.integers(0, w, 350); ys = rng.integers(0, h, 350)
    bs = rng.integers(110, 220, 350)
    for x, y, b in zip(xs, ys, bs):
        draw.ellipse([x-1, y-1, x+1, y+1], fill=(b, b, min(255, b+20)))

    # Estrellas brillantes con difracción
    xs = rng.integers(60, w-60, 50); ys = rng.integers(60, h-60, 50)
    for x, y in zip(xs, ys):
        b = int(rng.integers(190, 255))
        draw.ellipse([x-2, y-2, x+2, y+2], fill=(b, b, 255))
        for d in range(1, 8):
            a = int(b * (1-d/8) * 0.45)
            for ox, oy in ((d,0),(-d,0),(0,d),(0,-d)):
                if 0 <= x+ox < w and 0 <= y+oy < h:
                    draw.point((x+ox, y+oy), fill=(a, a, min(255, a+30)))

    return img

