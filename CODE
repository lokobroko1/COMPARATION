# ─── 8. HELPER: texto con glow ────────────────────────────────────
def paste_text_glow(
    base: Image.Image,
    text: str,
    xy: tuple,
    font,
    color: tuple,
    glow: tuple,
    blur_r: int = 8,
    anchor: str = "la",
) -> Image.Image:
    """Dibuja texto con glow sobre 'base' (RGB). Devuelve nueva imagen RGB."""
    canvas = base.convert("RGBA")

    # Capa de glow
    gl = Image.new("RGBA", canvas.size, (0, 0, 0, 0))
    gld = ImageDraw.Draw(gl)
    for dx in range(-blur_r//2, blur_r//2 + 1, 2):
        for dy in range(-blur_r//2, blur_r//2 + 1, 2):
            gld.text((xy[0]+dx, xy[1]+dy), text,
                     font=font, fill=(*glow[:3], 90), anchor=anchor)
    gl = gl.filter(ImageFilter.GaussianBlur(radius=max(1, blur_r//2)))

    # Texto principal
    td = ImageDraw.Draw(canvas)
    td.text(xy, text, font=font, fill=color, anchor=anchor)

    # Componer
    canvas.paste(gl, (0, 0), gl)
    td.text(xy, text, font=font, fill=color, anchor=anchor)

    return canvas.convert("RGB")

# ─── 9. HELPER: formato de comparación ──────────────────────────
def compare_text(obj_size: float, ref_size: float, ref_name: str) -> str:
    if ref_size <= 0:
        return ""
    ratio = obj_size / ref_size
    if ratio >= 1:
        if   ratio >= 1e15: return f"{ratio:.1e}× el tamaño de {ref_name}"
        elif ratio >= 1e12: return f"{ratio/1e12:.1f} billones de veces {ref_name}"
        elif ratio >= 1e9:  return f"{ratio/1e9:.1f} mil millones de veces {ref_name}"
        elif ratio >= 1e6:  return f"{ratio/1e6:.1f} millones de veces {ref_name}"
        elif ratio >= 1e3:  return f"{ratio/1e3:.0f} mil veces {ref_name}"
        else:               return f"{ratio:.1f}× el tamaño de {ref_name}"
    else:
        inv = 1 / ratio
        if   inv >= 1e15: return f"cabe {inv:.1e} veces en {ref_name}"
        elif inv >= 1e12: return f"cabe {inv/1e12:.1f} billones de veces en {ref_name}"
        elif inv >= 1e9:  return f"cabe {inv/1e9:.1f} mil millones de veces en {ref_name}"
        elif inv >= 1e6:  return f"cabe {inv/1e6:.1f} millones de veces en {ref_name}"
        elif inv >= 1e3:  return f"cabe {inv/1e3:.0f} mil veces en {ref_name}"
        else:             return f"cabe {inv:.1f} veces en {ref_name}"

# ─── 10. BARRA DE ESCALA LOGARÍTMICA ─────────────────────────────
# Rango logarítmico total de la secuencia
_LOG_MIN = math.log10(OBJECTS[0]["size"])
_LOG_MAX = math.log10(OBJECTS[-1]["size"])

def draw_scale_progress(img: Image.Image, obj_idx: int, obj: dict) -> Image.Image:
    draw = ImageDraw.Draw(img)

    bx1, by = 80, HEIGHT - 65
    bx2     = WIDTH - 80
    bh      = 7

    # Fondo de barra
    draw.rectangle([bx1-2, by-2, bx2+2, by+bh+2],
                   fill=(18, 18, 38), outline=(55, 55, 100))

    # Progreso basado en log del tamaño actual
    log_size  = math.log10(max(obj["size"], 1e-20))
    progress  = (log_size - _LOG_MIN) / (_LOG_MAX - _LOG_MIN)
    progress  = max(0.01, min(0.99, progress))
    prog_x    = int(bx1 + (bx2 - bx1) * progress)

    # Gradiente coloreado de la barra llenada
    filled_w = prog_x - bx1
    if filled_w > 0:
        bar_arr = np.zeros((bh, filled_w, 3), dtype=np.uint8)
        for xi in range(filled_w):
            t = xi / max(1, filled_w - 1)
            bar_arr[:, xi, 0] = int(60  + 170*t)
            bar_arr[:, xi, 1] = int(100 - 60*t)
            bar_arr[:, xi, 2] = int(220 - 120*t)
        bar_img = Image.fromarray(bar_arr, 'RGB')
        img.paste(bar_img, (bx1, by))

    # Marcadores de objetos importantes
    markers = [
        (1e-18, "quark"), (1e-10, "átomo"), (1e-3, "mm"),
        (1.7, "humano"),  (1.274e7, "Tierra"), (1.392e9, "Sol"),
        (9.461e20, "galaxia"), (8.8e26, "universo"),
    ]
    for msize, mlabel in markers:
        lp  = (math.log10(msize) - _LOG_MIN) / (_LOG_MAX - _LOG_MIN)
        lx  = int(bx1 + (bx2-bx1)*lp)
        draw.line([(lx, by-4), (lx, by-10)], fill=(70, 70, 115), width=1)
        draw.text((lx, by-14), mlabel, font=FONT_SMALL,
                  fill=(70, 70, 115), anchor="mb")

    # Indicador de posición actual
    draw.ellipse([prog_x-7, by-5, prog_x+7, by+bh+5],
                 fill=obj["color"], outline=(255,255,255), width=1)

    # Etiqueta de unidad centrada
    draw.text((WIDTH//2, by+bh+18), obj["unit_label"],
              font=FONT_UNIT, fill=(160, 170, 215), anchor="mt")

    return img

# ─── 11. GENERADOR DE FRAMES ──────────────────────────────────────
MAX_SPHERE = int(min(WIDTH, HEIGHT) * 0.56)
MIN_SPHERE = 50
SPHERE_CX  = int(WIDTH  * 0.37)
SPHERE_CY  = int(HEIGHT * 0.49)
TEXT_X     = int(WIDTH  * 0.57)

def make_frame(obj_idx: int, phase: str, t: float) -> Image.Image:
    """
    obj_idx : índice del objeto actual
    phase   : 'appear' | 'hold' | 'compare' | 'exit'
    t       : progreso 0..1 dentro de la fase
    """
    obj = OBJECTS[obj_idx]

    # ── Fondo ──────────────────────────────────────────────────
    frame = STARFIELD.copy()

    # ── Esfera: calcular tamaño según fase ─────────────────────
    if phase == 'appear':
        e       = ease_out_back(t, s=1.5)
        sp_size = int(MIN_SPHERE + (MAX_SPHERE - MIN_SPHERE) * e)
        sp_a    = int(255 * min(1.0, t * 2.5))
    elif phase in ('hold', 'compare'):
        sp_size = MAX_SPHERE
        sp_a    = 255
    else:   # exit
        e       = ease_in_cubic(t)
        sp_size = int(MAX_SPHERE * (1 - e * 0.6))
        sp_a    = int(255 * max(0.0, 1 - t * 1.6))

    sp_size = max(24, sp_size)
    sphere  = create_sphere(sp_size, obj["color"], obj["glow"])
    sw, sh  = sphere.size
    sx      = SPHERE_CX - sw // 2
    sy      = SPHERE_CY - sh // 2

    # Aplicar alpha de esfera
    if sp_a < 255:
        arr          = np.array(sphere)
        arr[:,:,3]   = (arr[:,:,3].astype(np.int32) * sp_a // 255).astype(np.uint8)
        sphere       = Image.fromarray(arr, 'RGBA')

    fr_rgba = frame.convert('RGBA')
    fr_rgba.paste(sphere, (sx, sy), sphere)
    frame   = fr_rgba.convert('RGB')

    # ── Alpha del texto ────────────────────────────────────────
    if phase == 'appear':
        txt_a = max(0.0, (t - 0.55) / 0.45)
    elif phase == 'hold':
        txt_a = min(1.0, t / 0.18)
    elif phase == 'compare':
        txt_a = 1.0
    else:
        txt_a = max(0.0, 1.0 - t * 2.5)
    txt_a = float(np.clip(txt_a, 0.0, 1.0))

    # ── Texto: categoría, nombre, hechos ──────────────────────
    if txt_a > 0.02:
        a8 = int(txt_a * 255)

        # Categoría (pequeño, encima)
        cat_col  = tuple(int(c * 0.75) for c in obj["color"])
        frame = paste_text_glow(frame, obj["category"],
                                (TEXT_X, int(HEIGHT*0.235)),
                                FONT_CAT, (*cat_col, a8), obj["glow"],
                                blur_r=5, anchor="lm")

        # Nombre (grande)
        frame = paste_text_glow(frame, obj["name"],
                                (TEXT_X, int(HEIGHT*0.355)),
                                FONT_NAME, (*obj["color"], a8), obj["glow"],
                                blur_r=18, anchor="lm")

        # Línea separadora
        tmp_d = ImageDraw.Draw(frame)
        lc    = tuple(int(c*0.45) for c in obj["color"])
        tmp_d.line([(TEXT_X, int(HEIGHT*0.435)),
                    (min(WIDTH-40, TEXT_X+560), int(HEIGHT*0.435))],
                   fill=lc, width=1)

        # Hechos (multi-línea)
        for i, line in enumerate(obj["fact"]):
            fy = int(HEIGHT*0.490) + i * 38
            frame = paste_text_glow(frame, line,
                                    (TEXT_X, fy),
                                    FONT_FACT,
                                    (200, 200, 222, a8),
                                    (60, 60, 90),
                                    blur_r=4, anchor="lm")

        # Unidad bajo los hechos
        uy = int(HEIGHT*0.490) + len(obj["fact"]) * 38 + 18
        frame = paste_text_glow(frame, obj["unit_label"],
                                (TEXT_X, uy),
                                FONT_UNIT,
                                (150, 175, 255, a8),
                                (50, 70, 180),
                                blur_r=4, anchor="lm")

    # ── Comparaciones (solo en fase compare) ──────────────────
    if phase == 'compare' and t > 0.08:
        comp_t = min(1.0, (t - 0.08) / 0.25)
        a8c    = int(255 * comp_t)

        lines_comp = []
        if obj["human_ref"] and obj["name"] != "Ser Humano":
            lines_comp.append((
                compare_text(obj["size"], 1.7, "un humano"),
                (255, 235, 90),
                (180, 155, 20),
            ))
        if obj["earth_ref"]:
            lines_comp.append((
                compare_text(obj["size"], 1.274e7, "la Tierra"),
                (100, 190, 255),
                (30, 100, 210),
            ))

        for ci, (ctxt, ccol, cglow) in enumerate(lines_comp):
            cy_pos = int(HEIGHT * 0.815) + ci * 48
            frame  = paste_text_glow(frame, ctxt,
                                     (WIDTH//2, cy_pos),
                                     FONT_COMP,
                                     (*ccol, a8c),
                                     cglow,
                                     blur_r=10,
                                     anchor="mm")

    # ── Barra de escala ────────────────────────────────────────
    frame = draw_scale_progress(frame, obj_idx, obj)

    # ── Título superior ───────────────────────────────────────
    hdr_draw = ImageDraw.Draw(frame)
    hdr_draw.text((WIDTH//2, 36),
                  "COMPARACIÓN DE TAMAÑOS: DEL QUARK AL UNIVERSO OBSERVABLE",
                  font=FONT_HEADER, fill=(165, 165, 205), anchor="mm")

    # Número de objeto / total
    hdr_draw.text((WIDTH - 40, 36),
                  f"{obj_idx+1} / {N_OBJECTS}",
                  font=FONT_SMALL, fill=(70, 70, 110), anchor="rm")

    # Watermark
    hdr_draw.text((WIDTH - 28, HEIGHT - 28),
                  "generado con IA · Python",
                  font=FONT_SMALL, fill=(45, 45, 80), anchor="rb")

    return frame


